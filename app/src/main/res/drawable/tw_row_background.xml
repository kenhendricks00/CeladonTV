<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/tw_focus_card" android:state_focused="true" />
    <item android:drawable="@drawable/tw_focus_card" android:state_selected="true" />
    <item android:drawable="@drawable/tw_focus_card" android:state_pressed="true" />
    <item>
        <inset android:inset="2.25dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/tw_surface" />
                <corners android:radius="5.4dp" />
            </shape>
        </inset>
    </item>
</selector>
