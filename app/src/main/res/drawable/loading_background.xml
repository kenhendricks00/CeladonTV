<?xml version="1.0" encoding="utf-8"?>
<!-- Twitch's dark background with a soft purple glow behind the logo. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tw_background" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:centerY="0.42"
                android:endColor="#009147FF"
                android:gradientRadius="460dp"
                android:startColor="#339147FF"
                android:type="radial" />
        </shape>
    </item>
</layer-list>
