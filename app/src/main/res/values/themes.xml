<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="twitch_background">#0E0E10</color>
    <color name="accent">#C026D3</color>

    <style name="Theme.TwitchCobalt" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/twitch_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <style name="Theme.TwitchCobalt.Settings" parent="Theme.AppCompat">
        <item name="android:windowBackground">@color/twitch_background</item>
        <item name="colorPrimary">@color/twitch_background</item>
        <item name="colorAccent">@color/accent</item>
    </style>
</resources>
